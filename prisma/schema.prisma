datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model Shift {
  id                 String             @id @default(cuid())
  name               String             @unique
  startTime          String             // Format: "HH:mm" (e.g. "08:00")
  endTime            String             // Format: "HH:mm" (e.g. "17:00")
  breakMinutes       Int                @default(60)
  standardHours      Decimal            @default(8.0) @db.Decimal(4, 2)
  gracePeriodMinutes Int                @default(15)
  isDefault          Boolean            @default(false)
  employees          Employee[]
  attendanceRecords  AttendanceRecord[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Employee {
  id                String             @id @default(cuid())
  employeeCode      String             @unique
  firstName         String
  lastName          String
  department        String             // Cutting, Sewing, Finishing, Quality, Maintenance, Admin
  designation       String             // Operator, Helper, Supervisor, Quality Inspector
  joiningDate       DateTime           @default(now())
  status            EmployeeStatus     @default(ACTIVE)
  baseSalary        Decimal            @db.Decimal(10, 2) // Monthly base salary
  hourlyRate        Decimal            @db.Decimal(10, 2) // Overtime calculation hourly rate
  shiftId           String?
  shift             Shift?             @relation(fields: [shiftId], references: [id])
  attendanceRecords AttendanceRecord[]
  payrollSummaries  PayrollSummary[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([department])
  @@index([status])
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId       String?
  shift         Shift?           @relation(fields: [shiftId], references: [id])
  date          DateTime         // Stored normalized to local day start UTC (YYYY-MM-DD)
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus @default(PRESENT)
  regularHours  Decimal          @default(0.0) @db.Decimal(5, 2)
  overtimeHours Decimal          @default(0.0) @db.Decimal(5, 2)
  remarks       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
}

model PayrollSummary {
  id                 String        @id @default(cuid())
  employeeId         String
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month              Int           // 1 - 12
  year               Int           // e.g. 2026
  totalWorkingDays   Int           @default(26)
  presentDays        Int           @default(0)
  absentDays         Int           @default(0)
  totalRegularHours  Decimal       @default(0.0) @db.Decimal(6, 2)
  totalOvertimeHours Decimal       @default(0.0) @db.Decimal(6, 2)
  basePay            Decimal       @db.Decimal(10, 2)
  overtimePay        Decimal       @db.Decimal(10, 2) // Calculated using 2.0x industrial OT multiplier
  deductions         Decimal       @default(0.0) @db.Decimal(10, 2)
  netPay             Decimal       @db.Decimal(10, 2)
  status             PayrollStatus @default(DRAFT)
  generatedAt        DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@index([employeeId])
}
